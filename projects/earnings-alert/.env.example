SLACK_WEBHOOK_URL=
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
MYREALTRIP_API_KEY=
# 브랜드커넥트 주소(brandconnect.naver.com/<여기>/...)의 숫자 = 본인 크리에이터 ID
BRANDCONNECT_ID=
# (선택) MYREALTRIP_MODE=api 로 두면 대시보드 대신 API 사용. 기본은 대시보드 읽기
# MYREALTRIP_MODE=
# 대시보드 읽기용 전용 디버깅 Chrome (open-chrome.sh 로 연 창에서 직접 로그인)
CDP_URL=http://127.0.0.1:9333
# 알림이 울리도록 메시지 앞에 붙는 멘션 (예: <!channel>, <!here>, <@멤버ID>). 비우면 멘션 없음
SLACK_MENTION=<!channel>
# 슬랙에서 앱을 멘션하면 바로 조회해서 답하기 (Socket Mode)
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
