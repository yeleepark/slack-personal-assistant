SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# 이 사용자의 메시지만 처리한다 (슬랙 프로필 > ⋯ > 멤버 ID 복사)
SLACK_ALLOWED_USER=U0XXXXXXX
# 메모 채널 ID. 채널에서 /invite 로 봇을 초대해야 한다
SLACK_MEMO_CHANNEL=C0XXXXXXX

# 일정/할 일을 해석할 Claude 모델 (기본 haiku)
# CLAUDE_MODEL=haiku
# 할 일 재알림 간격(분). 기본 120
# REMIND_MINUTES=120
# 알림 허용 시간대 (24시간제). 이 밖에는 보내지 않고 시작 시각에 이어서 보낸다
# REMIND_FROM=9
# REMIND_TO=22
