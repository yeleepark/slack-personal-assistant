SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# 이 사용자의 메시지만 처리한다 (슬랙 프로필 > ⋯ > 멤버 ID 복사). 다른 사람은 전부 무시
SLACK_ALLOWED_USER=U0XXXXXXX
# 작업을 받을 채널 ID (선택). 비우면 DM만 받는다. 채널에서 /invite 로 봇을 초대해야 한다
SLACK_WORK_CHANNEL=C0XXXXXXX

# Claude Code를 실행할 작업 폴더 (기본: 이 폴더)
# CLAUDE_WORKDIR=/path/to/workdir
# 매 작업 앞에 붙일 스킬/슬래시 커맨드 (선택). 예: /my-skill
# SKILL_COMMAND=/my-skill
# 채널에서 여러 메시지를 한 작업으로 묶는 대기 시간(초). 메시지가 올 때마다 연장된다
# BATCH_SECONDS=90
# 한 작업 최대 시간(분)
# TIMEOUT_MINUTES=40
# 미리 허용할 도구(쉼표 구분). 헤드리스라 승인 팝업이 없어서 여기 없는 도구는 거절된다
# ALLOWED_TOOLS=Read,Write,Edit,Glob,Grep,WebFetch,WebSearch,Skill,Bash(ls:*),Bash(cat:*)
